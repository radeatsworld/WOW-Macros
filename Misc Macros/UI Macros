-- TOGGLE GAMEPAD MODE
/console GamePadEnable 0


-- CLICK YES ON POP-UP
/click StaticPopup1Button1


-- TOGGLE CLICK TO MOVE
/run local k,v = "autointeract" v = C_CVar.GetCVar(k) C_CVar.SetCVar(k, 1 - v) print("Auto Interact " .. (v == "1" and "Disabled" or "Enabled"))
/script SetCVar("nameplateShowFriends", 0)
/script SetCVar("nameplateShowEnemies", 1)


-- SKIP ENCHANT WARNING
/click CraftCreateButton
/use 0 1
/click StaticPopup1Button1


-- TOGGLE SHOW LUA ERRORS
/run local t = t or 1; if t==1 then console scriptErrors 1; t=2; else console scriptErrors 0; t=1; end


-- TOGGLE UI PROFILES
/run local a,b=3,4 EditModeManagerFrame:SelectLayout(C_EditMode.GetLayouts().activeLayout==a and b or a)


-- RELOAD UI
/reload


-- TOGGLE MACRO MENU
/macro


-- OPEN KILLS TO LEVEL WINDOW
/ktl window
